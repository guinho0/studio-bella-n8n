# Qual LLM usar: ollama | openai | anthropic
LLM_PROVEDOR=openai

# Modelo. Exemplos:
#   ollama:    qwen3:8b  (rode antes: ollama pull qwen3:8b)
#   openai:    gpt-4o-mini
#   gemini:    gemini-3.5-flash  (use LLM_PROVEDOR=openai + OPENAI_BASE_URL do Gemini)
#   anthropic: claude-haiku-5-5
LLM_MODELO=gemini-3.5-flash

# Reservas (só LLM_PROVEDOR=openai): se o principal der 503/429/timeout, a chamada vai
# para o próximo da lista, e o que falhou fica 2 min em quarentena. O plano grátis do
# Gemini sobrecarrega em horário de pico; modelos "lite" costumam continuar respondendo.
LLM_MODELOS_RESERVA=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Timeout por chamada (s). Com reservas, um modelo travado não segura a mensagem.
LLM_TIMEOUT_S=25

# Para LLM_PROVEDOR=openai (serve para OpenAI, Gemini, Groq, OpenRouter...)
# Gemini (tem plano gratuito): https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=

# Para LLM_PROVEDOR=anthropic
ANTHROPIC_API_KEY=

# ---------- API / Docker ----------
# Se preenchido, a API exige o header X-API-Key com este valor (exceto /health).
API_TOKEN=

# URL pública do n8n. Preenchida automaticamente por scripts/tunel.ps1 (cloudflared).
WEBHOOK_URL=http://localhost:5678/

# ---------- Telegram ----------
# Token do bot criado no @BotFather. Lido só por scripts/importar_n8n.ps1 e tunel.ps1.
# Grave com: .\scripts\definir_token.ps1
TELEGRAM_BOT_TOKEN=

# ---------- Configuração dos workflows (lida pelo n8n via $env; não são segredos) ----------
# chat_id do dono no Telegram: recebe alertas de handoff e pode usar /responder e /liberar.
# Descubra mandando uma mensagem ao bot e olhando o "telefone" nos logs da API.
DONO_TELEGRAM_CHAT_ID=
# ID da planilha: o trecho entre /d/ e /edit na URL do Google Sheets. Aba: "Agendamentos".
GOOGLE_SHEET_ID=
# ID da agenda (Configurações da agenda > Integrar agenda > "ID da agenda"). Precisa ter
# formato de e-mail: o nó do n8n NÃO aceita "primary". Agenda principal = o seu Gmail.
GOOGLE_CALENDAR_ID=

# Chave da API do n8n (Settings > n8n API), usada para depurar execuções por script.
# Grave com: .\scripts\definir_segredo.ps1 N8N_API_KEY
N8N_API_KEY=
